{
  "name": "mango-clicker",
  "version": "1.0.0",
  "description": "Mango Clicker — an incremental farming game with harvesting/buildings and an achievements system, built with Express, libSQL and Drizzle ORM",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --config _extras/nodemon.json index.js",
    "dev:client": "vite",
    "db": "node src/db/seed.js",
    "test": "vitest run --reporter=verbose",
    "export": "zip -r export.zip . -x 'node_modules/*' 'export.zip'"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "fast-check": "^3.23.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
